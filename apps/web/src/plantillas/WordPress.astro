---
import Base from "../layouts/Base.astro";
import Migas from "../components/Migas.astro";
import { breadcrumbJsonLd, organizationJsonLd } from "../data/jsonld";
import { pagePath, t, tv, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = "paginas.wordpress";
const path = pagePath(lang, "wordpress");
const migas = [
  { name: t(lang, "comunes.migas_inicio"), path: pagePath(lang, "home") },
  { name: t(lang, "nav.wordpress"), path },
];
const bloques = tv<{ titulo: string; texto: string }[]>(lang, `${k}.bloques`);
---

<Base lang={lang} title={t(lang, `${k}.title`)} description={t(lang, `${k}.description`)} path={path} pageKey="wordpress" jsonld={[organizationJsonLd(), breadcrumbJsonLd(migas)]}>
  <Migas items={migas} />
  <section class="pagina">
    <div class="pagina__cabeza">
      <p class="susurro">{t(lang, "nav.wordpress")}</p>
      <h1>{t(lang, `${k}.h1`)}</h1>
      <p class="lead">{t(lang, `${k}.lead`)}</p>
      <div class="acciones" style="margin-top: 24px">
        <a class="btn btn--fantasma" href="https://wordpress.org/plugins/andarama-360/" rel="nofollow">{t(lang, `${k}.enlaces.wporg`)}</a>
        <a class="btn btn--fantasma" href="https://github.com/joseluissaorin/andarama/tree/main/packages/wordpress-plugin">{t(lang, `${k}.enlaces.repo`)}</a>
      </div>
    </div>
    <div class="malla">
      {bloques.map((b) => (
        <article>
          <h2>{b.titulo}</h2>
          <p set:html={b.texto} />
        </article>
      ))}
    </div>
    <section class="caja">
      <h2>{t(lang, "herramientas.comunes.cta_titulo")}</h2>
      <p>{t(lang, "herramientas.comunes.cta_texto")}</p>
      <a class="btn" href="https://app.andarama.com" data-cta="registro">{t(lang, "herramientas.comunes.cta_boton")}</a>
    </section>
  </section>
</Base>
