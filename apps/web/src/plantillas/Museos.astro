---
/**
 * Página para museos, archivos, bibliotecas, patrimonio y cabildos: hermana
 * de la de universidades, con secciones H2 pensadas para las palabras clave
 * del estudio («visita virtual museo», «museum virtual tour», «museu
 * virtual», «visite virtuelle musée», «tour virtuale musei»), una FAQ con
 * `FAQPage`, enlaces a las páginas y artículos afines y el mismo formulario
 * de contacto por `mailto:` que universidades, con asunto propio.
 */
import { publishedPosts } from "../data/rutas";
import Base from "../layouts/Base.astro";
import Migas from "../components/Migas.astro";
import Preguntas from "../components/Preguntas.astro";
import FormularioDemo from "../components/FormularioDemo.astro";
import { breadcrumbJsonLd, faqJsonLd, organizationJsonLd } from "../data/jsonld";
import { blogPostPath, DEFAULT_LANG, langName, pagePath, t, tv, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = "paginas.museos";
const path = pagePath(lang, "museos");
const migas = [
  { name: t(lang, "comunes.migas_inicio"), path: pagePath(lang, "home") },
  { name: t(lang, "nav.museos"), path },
];

/**
 * Artículo del blog en el idioma de la página; si aún no está traducido, el
 * original en español (y se avisa junto al enlace).
 */
const posts = await publishedPosts();
function articulo(slugEs: string): { path: string; lang: Lang } | null {
  const version = posts.find((p) => p.data.lang === lang && (p.data.slug === slugEs || p.data.translationOf === slugEs));
  if (version != null) return { path: blogPostPath(lang, version.data.slug), lang };
  // Si no hay traducción, el original en español; si aún no se ha publicado, nada
  const original = posts.find((p) => p.data.lang === DEFAULT_LANG && p.data.slug === slugEs);
  return original != null ? { path: blogPostPath(DEFAULT_LANG, slugEs), lang: DEFAULT_LANG } : null;
}
const articuloMuseo = articulo("visita-virtual-museo");
const articuloArchivo = articulo("recorrido-360-archivo-biblioteca");

/** Los textos del JSON llevan marcadores «{explorar}», «{formacion}»… que se vuelven rutas. */
const rutas: Record<string, string | undefined> = {
  universidades: pagePath(lang, "universidades"),
  formacion: pagePath(lang, "formacion"),
  aula: pagePath(lang, "aula"),
  accesibilidad: pagePath(lang, "accesibilidad"),
  explorar: "/explorar/",
  articulo_museo: articuloMuseo?.path,
  articulo_archivo: articuloArchivo?.path,
};
/**
 * Resuelve los marcadores. Un enlace a un artículo que aún no se ha
 * publicado se queda en texto: mejor sin enlace que con un 404.
 */
const conRutas = (s: string): string =>
  s
    .replace(/<a href="\{(\w+)\}">(.*?)<\/a>/g, (m, clave: string, texto: string) => (rutas[clave] != null ? m : texto))
    .replace(/\{(\w+)\}/g, (m, clave: string) => rutas[clave] ?? m);

const usos = tv<string[]>(lang, `${k}.usos.lista`);
const bloques = tv<{ titulo: string; texto: string }[]>(lang, `${k}.bloques`).map((b) => ({ ...b, texto: conRutas(b.texto) }));
const faq = tv<{ q: string; a: string }[]>(lang, `${k}.faq.lista`).map((f) => ({ ...f, a: conRutas(f.a) }));
const c = `${k}.contacto`;

const enlaces: { href: string; texto: string; lang?: Lang }[] = [
  { href: rutas.universidades!, texto: t(lang, `${k}.enlaces.universidades`) },
  { href: rutas.formacion!, texto: t(lang, `${k}.enlaces.formacion`) },
  { href: rutas.explorar!, texto: t(lang, `${k}.enlaces.explorar`) },
  ...(["seguridad", "accesibilidad", "contratacion"] as const).map((clave) => ({ href: pagePath(lang, clave), texto: t(lang, `paginas.${clave}.h1`) })),
  ...(articuloMuseo != null ? [{ href: articuloMuseo.path, texto: t(lang, `${k}.enlaces.articulo_museo`), lang: articuloMuseo.lang }] : []),
  ...(articuloArchivo != null ? [{ href: articuloArchivo.path, texto: t(lang, `${k}.enlaces.articulo_archivo`), lang: articuloArchivo.lang }] : []),
];
---

<Base
  lang={lang}
  title={t(lang, `${k}.title`)}
  description={t(lang, `${k}.description`)}
  path={path}
  pageKey="museos"
  jsonld={[organizationJsonLd(), breadcrumbJsonLd(migas), faqJsonLd(faq)]}
>
  <Migas items={migas} />
  <section class="pagina">
    <div class="pagina__cabeza">
      <p class="susurro">{t(lang, "nav.museos")}</p>
      <h1>{t(lang, `${k}.h1`)}</h1>
      <p class="lead">{t(lang, `${k}.lead`)}</p>
      <div class="acciones" style="margin-top: 24px">
        <a class="btn" href="#contacto">{t(lang, `${k}.cta.contacto`)}</a>
        <a class="btn btn--fantasma" href={rutas.explorar}>{t(lang, `${k}.cta.explorar`)}</a>
      </div>
    </div>
    <section class="caja">
      <h2>{t(lang, `${k}.usos.titulo`)}</h2>
      <p>{t(lang, `${k}.usos.texto`)}</p>
      <ul class="tics">
        {usos.map((x) => <li set:html={x} />)}
      </ul>
    </section>
    <div class="malla">
      {bloques.map((b) => (
        <article>
          <h2>{b.titulo}</h2>
          <p set:html={b.texto} />
        </article>
      ))}
    </div>
    <Preguntas titulo={t(lang, `${k}.faq.titulo`)} lista={faq} id="preguntas" />
    <section class="caja">
      <h2>{t(lang, `${k}.enlaces.titulo`)}</h2>
      <p>{t(lang, `${k}.enlaces.texto`)}</p>
      <ul class="tics">
        {enlaces.map((e) => (
          <li>
            <a href={e.href} hreflang={e.lang != null && e.lang !== lang ? e.lang : undefined}>{e.texto}</a>
            {e.lang != null && e.lang !== lang && <span class="susurro"> ({langName(e.lang)})</span>}
          </li>
        ))}
      </ul>
    </section>
    <FormularioDemo lang={lang} clave={c} origen="museos" naranja />
  </section>
</Base>
