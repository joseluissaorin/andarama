---
import Base from "../layouts/Base.astro";
import Migas from "../components/Migas.astro";
import FormularioDemo from "../components/FormularioDemo.astro";
import { breadcrumbJsonLd, organizationJsonLd } from "../data/jsonld";
import { pagePath, t, tv, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = "paginas.universidades";
const path = pagePath(lang, "universidades");
const migas = [
  { name: t(lang, "comunes.migas_inicio"), path: pagePath(lang, "home") },
  { name: t(lang, "nav.universidades"), path },
];
const bloques = tv<{ titulo: string; texto: string }[]>(lang, `${k}.bloques`);
const c = `${k}.contacto`;
---

<Base lang={lang} title={t(lang, `${k}.title`)} description={t(lang, `${k}.description`)} path={path} pageKey="universidades" jsonld={[organizationJsonLd(), breadcrumbJsonLd(migas)]}>
  <Migas items={migas} />
  <section class="pagina">
    <div class="pagina__cabeza">
      <p class="susurro">{t(lang, "nav.universidades")}</p>
      <h1>{t(lang, `${k}.h1`)}</h1>
      <p class="lead">{t(lang, `${k}.lead`)}</p>
    </div>
    <div class="malla">
      {bloques.map((b) => (
        <article>
          <h2>{b.titulo}</h2>
          <p set:html={b.texto} />
        </article>
      ))}
    </div>
    <section class="caja">
      <h2>{t(lang, "pie.confianza")}</h2>
      <ul class="tics">
        {(["seguridad", "accesibilidad", "codigoAbierto", "contratacion"] as const).map((clave) => (
          <li><a href={pagePath(lang, clave)}>{t(lang, `paginas.${clave}.h1`)}</a></li>
        ))}
      </ul>
    </section>
    <section class="caja caja--naranja">
      <h2>{t(lang, "paginas.museos.enlace_desde.titulo")}</h2>
      <p>{t(lang, "paginas.museos.enlace_desde.texto")}</p>
      <div class="acciones">
        <a class="btn" href={pagePath(lang, "museos")}>{t(lang, "paginas.museos.enlace_desde.boton")}</a>
      </div>
    </section>
    <FormularioDemo lang={lang} clave={c} origen="universidades" />
  </section>
</Base>
