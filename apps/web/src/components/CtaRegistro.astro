---
/** La caja final de cada herramienta: «¿Quieres convertirlo en un recorrido?». */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="caja caja--naranja">
  <h2>{t(lang, "herramientas.comunes.cta_titulo")}</h2>
  <p>{t(lang, "herramientas.comunes.cta_texto")}</p>
  <a class="btn" href="https://app.andarama.com/register" data-cta="registro">{t(lang, "herramientas.comunes.cta_boton")}</a>
</section>
