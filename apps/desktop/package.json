{
  "name": "@andarama/desktop",
  "version": "0.1.0",
  "description": "Andarama de escritorio: un solo ejecutable (Bun) con el servidor, el Studio y el visor dentro",
  "license": "EUPL-1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@andarama/adapters": "workspace:*",
    "@andarama/api": "workspace:*",
    "@andarama/db": "workspace:*",
    "@andarama/realtime": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
