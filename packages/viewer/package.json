{
  "name": "@ull360/viewer",
  "version": "0.1.0",
  "description": "Motor de visualizacion 360 de ULL360 (WebGL, base Marzipano con capas propias)",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
