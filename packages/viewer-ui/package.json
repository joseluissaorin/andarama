{
  "name": "@andarama/viewer-ui",
  "version": "0.1.0",
  "description": "Skin del visor Andarama: componentes de interfaz framework-agnostic",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle/*": "./dist/bundle/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@google/model-viewer": "^4.0.0",
    "@andarama/schema": "workspace:*",
    "@andarama/viewer": "workspace:*",
    "leaflet": "^1.9.4",
    "lucide": "^1.31.0",
    "pdfjs-dist": "^4.10.38",
    "hls.js": "^1.6.17",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
