{
  "name": "@andarama/adapters",
  "version": "0.1.0",
  "description": "Interfaces de plataforma de Andarama e implementaciones Cloudflare y Node",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./cloudflare": { "types": "./dist/cloudflare/index.d.ts", "import": "./dist/cloudflare/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@andarama/db": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.39.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "hash-wasm": "^4.12.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
