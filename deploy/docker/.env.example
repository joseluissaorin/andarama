# Copia este fichero como .env junto a docker-compose.yml y rellénalo.
# Solo APP_SECRET es obligatoria.

# Secreto de instancia: genera uno con `openssl rand -hex 32`
APP_SECRET=
# URL pública de la instancia (obligatoria detrás de proxy o TLS)
PUBLIC_URL=http://localhost:8788

# Administradores de la instancia, separados por comas (sin distinguir
# mayúsculas). Con la lista, solo estas direcciones administran: quien figure
# en ella se hace administrador al entrar y nadie más. Vacía: el primer
# usuario registrado administra la instancia.
ADMIN_EMAILS=

# Correo transaccional (opcional; sin él, los correos se escriben en el registro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=andarama@localhost

# SSO institucional OIDC (opcional)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=

# Almacenamiento S3/MinIO en lugar del disco local (opcional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Anti-spam en formularios públicos (opcional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Cuentas y planes con Clerk, como en andarama.com (opcional; el self-host no
# lo necesita). El secreto del webhook ("whsec_...") activa la supresión de
# cuentas borradas en Clerk y la fecha del primer pago.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
