# Configuración de una instalación propia de Andarama.
# Copia este fichero a .env (en esta misma carpeta, deploy/docker/) y rellénalo.
# Guía: https://docs.andarama.com/despliegue/servidor-propio/

# --- Obligatorias ---------------------------------------------------------

# Dirección pública con la que se entra en la instancia (sin barra final).
PUBLIC_URL=https://pruebaandarama.jls.name

# Secreto de la instancia: firma sesiones y enlaces. Genera uno con
#   openssl rand -hex 32
# y no lo cambies después (cerraría todas las sesiones y enlaces firmados).
APP_SECRET=

# --- Recomendada ----------------------------------------------------------

# Correos que serán administradores de la instancia, separados por comas.
# Si la defines, solo esas direcciones reciben el papel de administrador al
# registrarse, aunque otra persona se registre antes. Si la dejas vacía, el
# primer usuario que se registre será el administrador.
ADMIN_EMAILS=profesora@ejemplo.es,profesor@ejemplo.es

# --- HTTPS con Caddy (perfil «https») -------------------------------------

# Dominio que servirá Caddy con certificado de Let's Encrypt. Debe coincidir
# con el de PUBLIC_URL.
DOMINIO=pruebaandarama.jls.name
# Con Caddy delante, el puerto 8788 solo tiene que escuchar en la propia máquina.
ANDARAMA_BIND=127.0.0.1
# ANDARAMA_PORT=8788

# --- Opcionales -----------------------------------------------------------

# Imagen publicada (mientras no lo esté, `docker compose up -d --build` la construye).
# ANDARAMA_IMAGE=ghcr.io/joseluissaorin/andarama:latest

# Correo saliente (verificación de cuentas, invitaciones, recuperar contraseña).
# Sin SMTP las cuentas se dan de alta sin verificar el correo y los mensajes
# solo se escriben en el registro del contenedor.
# SMTP_HOST=smtp.ejemplo.es
# SMTP_PORT=587
# SMTP_SECURE=      # 1 para TLS directo (puerto 465)
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=andarama@ejemplo.es

# Inicio de sesión institucional (OIDC: Google Workspace, Microsoft Entra, Keycloak…).
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=ejemplo.es

# Antispam de Cloudflare Turnstile en los formularios de los tours publicados.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Almacenamiento en S3 o MinIO en lugar del disco del servidor.
# S3_ENDPOINT=
# S3_BUCKET=andarama
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Mostrar en / la portada de andarama.com en vez de llevar directo al Studio.
# SHOW_LANDING=1
