# HTTPS automático para una instalación propia de Andarama.
# El dominio sale de DOMINIO en el .env (p. ej. pruebaandarama.jls.name);
# PUBLIC_URL tiene que ser https:// con ese mismo dominio.
# Caddy pide y renueva solo el certificado de Let's Encrypt: basta con que el
# DNS apunte al servidor y los puertos 80 y 443 estén abiertos.
{$DOMINIO} {
	encode zstd gzip
	# Subidas de panorámicas grandes: el servidor admite hasta 512 MB.
	request_body {
		max_size 512MB
	}
	reverse_proxy andarama:8788
}
