// Infraestructura como codigo del despliegue Cloudflare de Andarama (§5.7).
// El script bootstrap (pnpm deploy:cloudflare) crea los recursos y rellena
// los IDs marcados; actualizar la instancia = volver a ejecutarlo.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "andarama",
  "main": "../../apps/api/src/worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../../apps/studio/dist-root",
    "binding": "ASSETS",
    // "/studio", "/studio/", "/docs" y "/docs/*" pasan por el worker para que
    // los subdominios (app., docs.) puedan redirigir a sus URL limpias; el
    // manifiesto pasa porque en app.andarama.com se sirve el gemelo con
    // ambito raiz. Los assets con hash se sirven directos.
    "run_worker_first": [
      "/api/*", "/t/*", "/ingest/*", "/rt/*", "/sitemap.xml", "/robots.txt", "/",
      "/studio", "/studio/", "/studio/manifest.webmanifest", "/docs", "/docs/*", "/embed.js"
    ]
  },

  // Dominios de la instancia de referencia: la landing en el apex, la app y
  // la documentacion en sus subdominios. Requiere la zona andarama.com en la
  // misma cuenta; wrangler los aprovisiona al desplegar.
  "routes": [
    { "pattern": "andarama.com", "custom_domain": true },
    { "pattern": "www.andarama.com", "custom_domain": true },
    { "pattern": "app.andarama.com", "custom_domain": true },
    { "pattern": "docs.andarama.com", "custom_domain": true }
  ],

  // Los nombres de los recursos (D1, R2, dataset) conservan el nombre
  // historico del proyecto, ull360: los datos de la instancia viven ahi y
  // renombrarlos exigiria migrarlos. Solo son identificadores internos.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ull360",
      "database_id": "2f1cd3a6-5255-45e4-a60e-ea90d2dfe525",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ull360"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e72cb40130224aef87d64ee07c7a144b"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "LIVE_DO", "class_name": "LiveTourRoomDO" },
      { "name": "PRESENCE_DO", "class_name": "ProjectPresenceDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveTourRoomDO", "ProjectPresenceDO"]
    }
  ],

  // Workers Analytics Engine (§2.14). Con ANALYTICS_BACKEND=d1 se usa la
  // tabla D1 en su lugar (consultable sin token de API).
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "ull360_events" }
  ],

  // Workers AI: sugerencia de texto alternativo en el editor (§2.11)
  "ai": { "binding": "AI" },

  // Cloudflare Queues requiere plan Workers Paid. El bootstrap descomenta
  // este bloque si detecta que la cuenta lo soporta; sin Queues, los
  // trabajos quedan en la tabla `jobs` para el contenedor de procesado.
  // "queues": {
  //   "producers": [{ "binding": "QUEUE", "queue": "anda-jobs" }],
  //   "consumers": [{ "queue": "anda-jobs", "max_batch_size": 5 }]
  // },

  "triggers": {
    "crons": ["17 3 * * *"]
  },

  "vars": {
    "ANALYTICS_BACKEND": "d1",
    "ANALYTICS_DATASET": "ull360_events",
    "PUBLIC_URL": "https://andarama.com"
  },

  "observability": {
    "enabled": true
  }

  // Secretos (wrangler secret put, los solicita el bootstrap):
  //   APP_SECRET            (obligatorio; HMAC de subidas y sesiones)
  //   EMAIL_WEBHOOK_URL/KEY (opcional; envio de email transaccional)
  //   TURNSTILE_SITE_KEY/SECRET (opcional; anti-spam en formularios)
  //   OIDC_ISSUER/CLIENT_ID/CLIENT_SECRET/ALLOWED_DOMAINS (opcional; SSO)
  //   CF_ACCOUNT_ID + CF_ANALYTICS_TOKEN (opcional; consultas AE)
  //   R2_ACCESS_KEY_ID/SECRET + R2_BUCKET_NAME (opcional; presign S3 directo)
  //   STREAM_ACCOUNT_ID/API_TOKEN (opcional; Cloudflare Stream)
}
