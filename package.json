{
  "name": "ull360",
  "version": "0.1.0",
  "private": true,
  "description": "ULL360 - Plataforma de tours virtuales 360 de codigo abierto de la Universidad de La Laguna",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/joseluissaorin/ull360.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @ull360/studio build && pnpm --filter @ull360/api build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --filter @ull360/api dev",
    "dev:studio": "pnpm --filter @ull360/studio dev",
    "dev:node": "pnpm --filter @ull360/api dev:node",
    "test": "pnpm -r test",
    "test:e2e": "playwright test -c tooling/playwright.config.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "deploy:cloudflare": "node deploy/cloudflare/bootstrap.mjs",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t ull360 .",
    "docker:up": "docker compose -f deploy/docker/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "eslint": "^9.20.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "prettier": "^3.5.0",
    "vitest": "^3.0.5",
    "@playwright/test": "^1.50.1"
  },
  "homepage": "https://ull360.jlsf2005.workers.dev",
  "bugs": {
    "url": "https://github.com/joseluissaorin/ull360/issues"
  }
}
